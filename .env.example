# ================================
# CORE SERVICES CONFIGURATION
# ================================
# These are the primary services required for the application to function

# --------------------------------
# Supabase Configuration
# --------------------------------
# Database and authentication backend
# Get from: https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# --------------------------------
# OpenAI Configuration
# --------------------------------
# OpenAI API Key for Vercel AI SDK Embedding Service (INTEL-001)
# Used for generating text embeddings using text-embedding-ada-002 or text-embedding-3-small
# Cost: ~$0.0001 per 1K tokens (~$0.003 per medium document)
# Get from: https://platform.openai.com/api-keys
# Format: sk-proj-... (project-scoped API key)
OPENAI_API_KEY=sk-proj-your_openai_api_key

# --------------------------------
# Pinecone Configuration
# --------------------------------
# Pinecone Vector Store Service (INTEL-003)
# Server-side API key for direct Pinecone operations
# Get from: https://app.pinecone.io/organizations/-/projects/-/keys
# Format: pc-... (Pinecone API key)
PINECONE_API_KEY=pc-your_pinecone_api_key

# Pinecone index name (must be created beforehand in Pinecone console)
# Default: intelliaa-documents
PINECONE_INDEX=intelliaa-documents

# Pinecone environment/region (optional)
# Common values: us-east-1-aws, us-west-2-aws, eu-west-1-aws
# Default: us-east-1-aws
PINECONE_ENVIRONMENT=us-east-1-aws

# --------------------------------
# VAPI Configuration
# --------------------------------
# VAPI Voice AI Platform for voice assistant management
# Get from: https://dashboard.vapi.ai/
NEXT_PRIVATE_VAPI_KEY=your_vapi_private_key
NEXT_PUBLIC_VAPI_KEY=your_vapi_public_key

# ================================
# AI & VOICE SERVICES
# ================================

# --------------------------------
# ElevenLabs Voice Synthesis
# --------------------------------
# Text-to-speech and voice cloning service
# Get from: https://elevenlabs.io/app/settings/api-keys
NEXT_PUBLIC_ELEVENLABS_TOKEN=your_elevenlabs_token

# ================================
# CLOUD SERVICES & STORAGE
# ================================

# --------------------------------
# AWS S3 Configuration
# --------------------------------
# File storage for documents and media
# Get from: AWS IAM Console
NEXT_AWS_S3_ACCESS_KEY_ID=your_aws_access_key_id
NEXT_AWS_S3_SECRET_ACCESS_KEY=your_aws_secret_access_key
NEXT_AWS_S3_BUCKET_NAME=your_bucket_name
NEXT_AWS_S3_BUCKET_URL_FILE=https://your-bucket.s3.amazonaws.com/
NEXT_AWS_S3_REGION=us-east-1

# --------------------------------
# Upstash Redis Configuration
# --------------------------------
# Serverless Redis for caching and rate limiting
# Get from: https://console.upstash.com/
UPSTASH_REDIS_REST_URL=https://your-redis-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_token

# ================================
# COMMUNICATION SERVICES
# ================================

# --------------------------------
# Twilio Configuration
# --------------------------------
# Telephony and SMS services
# Get from: https://console.twilio.com/
NEXT_PUBLIC_TWILIO_ACCOUNT_SID=your_twilio_account_sid
NEXT_PUBLIC_TWILIO_AUTH_TOKEN=your_twilio_auth_token

# --------------------------------
# Resend Email Service
# --------------------------------
# Transactional email delivery
# Get from: https://resend.com/api-keys
NEXT_PUBLIC_RESEND_KEY=your_resend_api_key

# ================================
# DEPLOYMENT & INFRASTRUCTURE
# ================================

# --------------------------------
# Railway GraphQL Backend
# --------------------------------
# WhatsApp bot deployment and management
# Get from: Railway dashboard and GitHub settings
NEXT_PUBLIC_RAILWAY_URI=https://backboard.railway.app/graphql/v2
NEXT_PUBLIC_RAILWAY_TOKEN=your_railway_token
NEXT_PUBLIC_RAILWAY_PROYECTID=your_railway_project_id
NEXT_PUBLIC_RAILWAY_REPOSITORY_CHAT=your_github_org/your_repository
NEXT_RAILWAY_BRANCH=develop

# --------------------------------
# Buildship/Railway Deployment
# --------------------------------
# Webhook endpoint for WhatsApp bot deployment
NEXT_PUBLIC_BUILDSHIP_URL_DEPLOY_RAILWAY=https://your-buildship-url.buildship.run/api/deploy-ws-dev-intelliaa

# ================================
# FEATURE FLAGS & CONFIGURATION
# ================================

# --------------------------------
# Vercel AI SDK Feature Flag
# --------------------------------
# Enable/disable Vercel AI SDK embedding service (INTEL-001)
# When true: Uses Vercel AI SDK with OpenAI for document embeddings
# When false (default): Uses existing Flowise service
# This allows for gradual rollout and easy rollback
# Values: true | false
# Default: false
NEXT_PUBLIC_USE_VERCEL_EMBEDDINGS=false

# ================================
# APPLICATION CONFIGURATION
# ================================

# --------------------------------
# Application URL
# --------------------------------
# Public URL where the application is deployed
# Development: http://localhost:3000
# Production: https://your-domain.com
NEXT_PUBLIC_URL=http://localhost:3000

# --------------------------------
# Event Token
# --------------------------------
# Internal event tracking/webhook validation token
NEXT_PUBLIC_EVENT_TOKEN=your_event_token

# --------------------------------
# API Keys
# --------------------------------
# General API key for internal services
NEXT_PUBLIC_MY_API_KEY=your_api_key

# ================================
# LEGACY FLOWISE CONFIGURATION
# ================================
# ⚠️ DEPRECATED: These variables are being phased out
# They are kept for backward compatibility during migration
# Will be removed in future releases after complete migration to Vercel AI SDK

# --------------------------------
# Flowise Configuration (DEPRECATED)
# --------------------------------
# ⚠️ DEPRECATED: Use OPENAI_API_KEY instead
# NEXT_PUBLIC_OPENAI_API_KEY_FLOWISE=your_openai_api_key_for_flowise

# ⚠️ DEPRECATED: Use PINECONE_API_KEY instead
# NEXT_PUBLIC_PINECONE_API_KEY_FLOWISE=your_pinecone_api_key_for_flowise
# NEXT_PUBLIC_PINECONE_INDEX=your_pinecone_index_name

# ⚠️ DEPRECATED: No longer needed (record manager not used)
# NEXT_PUBLIC_POSTGRES_API_KEY_FLOWISE=your_postgres_api_key_for_flowise

# ⚠️ DEPRECATED: Flowise service endpoints
# NEXT_PUBLIC_FLOWISE=https://your-flowise-instance.com/api/v1/
# NEXT_PUBLIC_FLOWISE_KEY=your_flowise_api_key
# NEXT_PUBLIC_USERNAME_FLOWISE=your_flowise_username
# NEXT_PUBLIC_PASSWORD_FLOWISE=your_flowise_password
# NEXT_PUBLIC_FLOWISE_CHATID_PREDICTION=your_flowise_chatid_prediction
# NEXT_PUBLIC_FLOWISE_CHATID_RESUMEN_PDF=your_flowise_chatid_resumen_pdf
# NEXT_PUBLIC_FLOWISE_CHATID_UPSERTPDF=your_flowise_chatid_upsertpdf
# NEXT_PUBLIC_FLOWISE_CHATID_UPSERTQA=your_flowise_chatid_upsertqa
# NEXT_PUBLIC_FLOWISE_CHATWS_PREDICTION=https://your-flowise-instance.com/api/v1/prediction/your_prediction_id
# NEXT_PUBLIC_OPENAI_KEY=your_openai_api_key

# ================================
# ENVIRONMENT-SPECIFIC NOTES
# ================================
#
# Development (.env.local):
# - Use test/development API keys
# - NEXT_PUBLIC_URL=http://localhost:3000
# - NEXT_PUBLIC_USE_VERCEL_EMBEDDINGS=true (for testing new features)
#
# Staging:
# - Use staging-specific API keys
# - NEXT_PUBLIC_URL=https://staging.your-domain.com
# - Test feature flags before production
#
# Production:
# - Use production API keys (separate from dev/staging)
# - NEXT_PUBLIC_URL=https://your-domain.com
# - NEXT_PUBLIC_USE_VERCEL_EMBEDDINGS=false (until fully tested)
# - Set all sensitive variables in deployment platform secrets (Vercel/Railway)
# - Never commit .env.local or .env.production to git
#
# Security Best Practices:
# - Rotate API keys periodically
# - Use different keys for each environment
# - Limit API key permissions where possible
# - Monitor API usage for anomalies
# - Keep server-side variables (no NEXT_PUBLIC_ prefix) secret
# - Only expose NEXT_PUBLIC_ variables that are safe for client-side use
